
# Contact forms: provision both keys and exact hostnames to activate Turnstile.
# Blank keys leave Turnstile inactive; honeypots still apply.
# TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated bare hostnames, e.g. example.dk,www.example.dk
TURNSTILE_HOSTNAMES=

# Explicit provider: cap, turnstile, or none. Unset preserves legacy settings.
# Cap requires an independent key per customer/environment/contact surface.
# CONTACT_SPAM_PROVIDER=cap
CAP_SITE_KEY=
CAP_SECRET_KEY=
# Server-only origin, e.g. http://cap.contact-protection.svc.cluster.local:3000
CAP_VERIFY_BASE_URL=
# Browser-reachable HTTPS origin, e.g. https://challenge.scaleweb.dk
CAP_PUBLIC_BASE_URL=

# Free self-hosted ALTCHA core pilot; select altcha only once the service is deployed.
# CONTACT_SPAM_PROVIDER=altcha
ALTCHA_SITE_KEY=
ALTCHA_SECRET_KEY=
ALTCHA_VERIFY_BASE_URL=
ALTCHA_PUBLIC_BASE_URL=
